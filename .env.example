# Postgres (Neon etc). Leave empty in local dev to use the embedded PGLite database.
DATABASE_URL=

# Browser fulfillment desk. Staff usernames are configured in src/lib/auth.server.ts.
# Generate a scrypt hash and session secret with `npm run staff:hash-password`.
STAFF_PASSWORD_HASH=
STAFF_SESSION_SECRET=

# GCash/Maya payment instructions shown at checkout
GCASH_NUMBER=
GCASH_NAME=
